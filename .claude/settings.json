{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(themes/**)",
      "Read(plugins/**)",
      "Read(mu-plugins/**)",
      "Read(tests/**)",
      "Read(composer.json)",
      "Read(package.json)",
      "Read(phpcs.xml.dist)",
      "Read(phpunit.xml.dist)",
      "Read(.editorconfig)",
      "Read(PROJECT-SPEC.md)",
      "Read(DECISIONS.md)",
      "Read(.claude/reference/**)",
      "Edit(themes/**)",
      "Edit(plugins/**)",
      "Edit(mu-plugins/**)",
      "Edit(tests/**)",
      "Bash(composer phpcs)",
      "Bash(composer phpcs -- *)",
      "Bash(composer phpcbf)",
      "Bash(composer phpcbf -- *)",
      "Bash(composer test)",
      "Bash(composer test -- *)",
      "Bash(npm run build)",
      "Bash(npm run start)",
      "Bash(npm run lint)",
      "Bash(npx wp-env *)",
      "WebFetch(domain:github.com)",
      "Bash(git clone *)",
      "Read(//Users/flynnoconnor/Documents/Obsidian Vault/wiki/tools/**)",
      "Read(//Users/flynnoconnor/Documents/Obsidian Vault/wiki/workflows/**)",
      "Read(//Users/flynnoconnor/Documents/Obsidian Vault/wiki/topics/**)",
      "Read(//Users/flynnoconnor/Documents/Obsidian Vault/wiki/synthesis/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/wp-config.php)",
      "Read(**/credentials*)",
      "Read(**/secrets*)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "additionalDirectories": [
      "/Users/flynnoconnor/Documents/Obsidian Vault/wiki/workflows",
      "/Users/flynnoconnor/Sites/wp-scaffold-global",
      "/Users/flynnoconnor/Documents/Obsidian Vault/wiki/tools",
      "/Users/flynnoconnor/Documents/Obsidian Vault/wiki/topics",
      "/Users/flynnoconnor/Documents/Obsidian Vault/wiki/synthesis"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/phpcs-check.sh\"",
            "timeout": 60,
            "statusMessage": "Running phpcbf + phpcs\u2026"
          }
        ]
      }
    ]
  }
}
